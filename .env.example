# Reg IRIS ingestion settings.
# Copy this file to .env (same folder) and change values there.
# .env is personal and must never be committed to git; .env.example is the shared template.
# Any value left out uses the default from services/ingestion/app/config.py.

IRIS_ENVIRONMENT=dev
IRIS_LOG_LEVEL=INFO

# Leave commented to use <project root>/data. A relative path is resolved from the project root.
# IRIS_DATA_DIR=data

IRIS_MAX_UPLOAD_SIZE_MB=50

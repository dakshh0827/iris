# Reg IRIS ingestion settings.
# Copy this file to .env (same folder) and change values there.
# .env is personal and must never be committed to git; .env.example is the shared template.
# Any value left out uses the default from services/ingestion/app/config.py.

IRIS_ENVIRONMENT=dev
IRIS_LOG_LEVEL=INFO

# Leave commented to use <project root>/data. A relative path is resolved from the project root.
# IRIS_DATA_DIR=data

IRIS_MAX_UPLOAD_SIZE_MB=50

# --- PostgreSQL (Phase 5) ---
# docker-compose.yml reads these three to create the database server.
# Choose your own password in .env; never commit it.
IRIS_DB_USER=iris
IRIS_DB_PASSWORD=change-me
IRIS_DB_NAME=reg_iris
# The service connects with this URL. Put the same password in it.
IRIS_DATABASE_URL=postgresql+psycopg://iris:change-me@localhost:5432/reg_iris
# The tests use a separate database (created automatically by docker compose).
IRIS_TEST_DATABASE_URL=postgresql+psycopg://iris:change-me@localhost:5432/reg_iris_test
